{
  "name": "interactive-comments-section",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "start:web": "pnpm run --filter web dev",
    "start:server": "pnpm run --filter server dev",
    "dev": "concurrently \"pnpm run start:web\" \"pnpm run start:server\"",
    "test:server": "pnpm run --filter server test",
    "build": "pnpm recursive run build",
    "test": "pnpm recursive run test"
  },
  "dependencies": {
    "concurrently": "~9.2.1",
    "web": "workspace:web",
    "server": "workspace:server"
  },
  "devDependencies": {}
}
